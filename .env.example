# Copy to .env (run.ps1 does this for you). Placeholders only - this project needs NO secrets or API keys.

# --- source (verified endpoint; change only if EGX changes it) ---
EGX_SOURCE_BASE_URL=https://beta.egx.com.eg
EGX_SOURCE_PATH=/api/bff/egx/market-watch
EGX_PAGE_SIZE=50                  # 10, 25 and 50 verified; run scripts\test_source.py --probe-page-size before going higher
EGX_USER_AGENT=egx-live-api/1.0 (personal research client)

# --- how the source is read ---
EGX_FETCH_MODE=passive            # passive = a real Chromium page does the requests and we only read its responses; http = plain HTTP (empty 404)
EGX_BROWSER_HEADLESS=false        # true = hidden window; UNVERIFIED, the site may treat it differently
# UI controls of the page (defaults are guesses until scripts\discover_ui.py confirms them):
# EGX_UI_NEXT_SELECTOR=button[aria-label*="next" i]
# EGX_UI_ROWS_SELECTOR=
EGX_UI_DELAY_MIN=0.8
EGX_UI_DELAY_MAX=1.8
EGX_UI_RESPONSE_TIMEOUT=30
EGX_TRUST_SOURCE_OPEN=false       # openPrice equalled prevClose in all captured records; leave false until verified in-session

# --- polling (seconds). Hard floor EGX_POLL_MIN_INTERVAL applies whatever you set below ---
EGX_POLLING_ENABLED=true
EGX_POLL_INTERVAL_OPEN=120
EGX_POLL_INTERVAL_CLOSED=900
EGX_POLL_MIN_INTERVAL=30

# --- HTTP ---
EGX_CONNECT_TIMEOUT=5
EGX_READ_TIMEOUT=20
EGX_MAX_RETRIES=3

# --- market calendar used ONLY for freshness labelling (hours are configuration, not verified) ---
EGX_MARKET_TIMEZONE=Africa/Cairo
EGX_MARKET_OPEN=10:00
EGX_MARKET_CLOSE=14:30
EGX_HOLIDAYS=                     # comma-separated YYYY-MM-DD, e.g. 2026-10-06
EGX_FRESH_MAX_AGE_OPEN=300

# --- storage ---
EGX_DATABASE_PATH=data/egx.sqlite3
EGX_HISTORY_ENABLED=true
EGX_HISTORY_RETENTION_DAYS=30
EGX_HISTORY_MIN_INTERVAL=300

# --- API ---
EGX_DEFAULT_LIMIT=100
EGX_MAX_LIMIT=500
EGX_CORS_ORIGINS=                 # e.g. http://localhost:3000 (empty = CORS disabled)
EGX_LOG_LEVEL=INFO
